# Copy to .env and fill in. Every adapter is gated behind config — if a key
# (or a running IB Gateway) is missing, the adapter fails loudly with a clear
# message rather than the dashboard crashing.

# --- Alpaca (equities) ---
# https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Databento (futures, historical) ---
# https://databento.com/
DATABENTO_API_KEY=

# --- Interactive Brokers (futures / equities via Gateway / TWS) ---
# Start IB Gateway or TWS locally and enable the API.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497          # 7497 paper TWS, 7496 live TWS, 4002 paper GW, 4001 live GW
IBKR_CLIENT_ID=17

# --- CCXT (crypto) ---
# Only needed for private endpoints; OHLCV is public.
CCXT_EXCHANGE=binance
CCXT_API_KEY=
CCXT_API_SECRET=

# --- Cache ---
QUANT_DASHBOARD_CACHE_DIR=.cache/quant-dashboard
